  <div class="container mt-3">
  <div class="row row-cols-3">
    <% blogs.forEach(blog => { %>
    <div class="col">

      <div class="card col my-2 mx-2" style="width: 18rem;">
        <img src=<%=encodeURI( blog.coverImageUrl )%> class="card-img-top" alt="...">
        <div class="card-body">
          <h5 class="card-title"><%= blog.title %></h5>
          <p class="card-text text-limit"><%= blog.body %></p>
          <a href="/blog/<%-blog._id%>" class="btn btn-outline-primary">Know more</a>
        </div>
      </div>
    </div>
    <% }) %>
  </div>